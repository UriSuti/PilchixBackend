PORT=3000
FRONTEND_URL=http://localhost:5173

# Supabase (Project Settings > API)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=

# Auth
JWT_SECRET=
JWT_EXPIRES=7d

# Mercado Pago
MP_ACCESS_TOKEN=

# Probador virtual (FASHN)
FASHN_API_KEY=

# AI Stylist: cualquier API compatible con OpenAI Chat Completions.
# Por defecto Google Gemini, que tiene plan gratis (clave en https://aistudio.google.com/apikey).
AI_API_KEY=
# Opcionales (estos son los valores por defecto):
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Lista separada por comas: si uno está saturado o sin cuota, se usa el siguiente.
# AI_MODEL=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-flash-latest
# AI_REASONING_EFFORT=low
#
# Alternativas gratis:
#   Groq:   AI_BASE_URL=https://api.groq.com/openai/v1  AI_MODEL=openai/gpt-oss-120b
#   Ollama: AI_BASE_URL=http://localhost:11434/v1        AI_MODEL=qwen3:8b  (sin AI_API_KEY, corre en tu PC)
